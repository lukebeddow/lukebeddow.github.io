---
// A research role: title, organisation, dates and a short summary, with the role's clip beside it.
// Text comes first so it is clear what the clip shows; without a clip the text spans the row.
import Clip from './Clip.astro';
import { REVIEW, dateSpan } from '../lib/site';

interface Props {
  id: string;
  title: string;
  org: string;
  orgUrl?: string | undefined;
  start: string;
  end: string;
  summary: string;
  href?: string | undefined;
  clip?: { video: string; poster: string; alt: string; aspect?: string | undefined } | undefined;
  draft: boolean;
}
const r = Astro.props;
---
<article class:list={['role', { 'no-clip': !r.clip, draft: REVIEW && r.draft }]} id={`role-${r.id}`}>
  <div class="role-text">
    <h3>{r.href ? <a href={r.href}>{r.title}</a> : r.title}</h3>
    <p class="org">
      {r.orgUrl ? <a href={r.orgUrl} target="_blank" rel="noopener">{r.org}</a> : r.org}
      <span class="dates">{dateSpan(r.start, r.end)}</span>
    </p>
    <p class="summary">{r.summary}</p>
  </div>
  {r.clip && <Clip clip={r.clip} natural />}
</article>
