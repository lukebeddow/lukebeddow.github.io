---
// A "Work" card: the role's best clip beside its title, organisation, dates and two or three points.
// Without a clip (e.g. footage awaiting approval) the text spans the full width.
import Clip from './Clip.astro';
import { REVIEW, yearSpan } from '../lib/site';

interface Props {
  id: string;
  title: string;
  org: string;
  orgUrl?: string | undefined;
  start: string;
  end: string;
  points: string[];
  links: { label: string; url: string }[];
  clip?: { video: string; poster: string; alt: string; aspect?: string | undefined } | undefined;
  draft: boolean;
}
const r = Astro.props;
const external = (url: string) => /^https?:/.test(url);
---
<article class:list={['role', { 'no-clip': !r.clip, draft: REVIEW && r.draft }]} id={`role-${r.id}`}>
  {r.clip && <Clip clip={r.clip} natural />}
  <div>
    <h3>{r.title}</h3>
    <p class="org">
      {r.orgUrl ? <a href={r.orgUrl} target="_blank" rel="noopener">{r.org}</a> : r.org}
      <span class="dates">{yearSpan(r.start, r.end)}</span>
    </p>
    <ul>{r.points.map((p) => <li>{p}</li>)}</ul>
    {r.links.length > 0 && (
      <p class="links">
        {r.links.map((l) => <a href={l.url} {...(external(l.url) ? { target: '_blank', rel: 'noopener' } : {})}>{l.label}</a>)}
      </p>
    )}
  </div>
</article>
